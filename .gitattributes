# Normalize line endings inside the repository
* text=auto

# Shell scripts must keep LF for POSIX hosts
*.sh text eol=lf

# PowerShell scripts keep CRLF
*.ps1 text eol=crlf

# Text formats
*.tex text diff=tex
*.bib text
*.m text

# Binary formats
*.pdf binary
*.png binary
*.jpg binary
*.eps binary
*.docx binary
*.xlsx binary
